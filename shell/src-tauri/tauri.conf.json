{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchiGoat",
  "version": "1.0.0",
  "identifier": "com.archigoat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ArchiGoat",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob: preview: http://preview.localhost; media-src 'self' blob: preview: http://preview.localhost; frame-src 'self' blob: preview: http://preview.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Desktop creation studio",
    "longDescription": "Create with your own coding Agent and receive a playable result.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "triangoat.com"
    }
  }
}
